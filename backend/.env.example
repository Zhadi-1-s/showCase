# MongoDB (local demo)
MONGODB_URI=mongodb://localhost:27017/lombard_dev

# JWT
JWT_SECRET=change_me_min_32_characters_long_secret
JWT_EXPIRATION=7d

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# Cloudinary (photo uploads) — без точки с запятой в конце значений
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lombard-products

# Telegram Bot API (BotFather token) — публикация в каналы
TELEGRAM_BOT_TOKEN=

# Navigation assistant bot (optional, last stage)
CHAT_BOT_ENABLED=false
CHAT_BOT_API_URL=
CHAT_BOT_API_KEY=
CHAT_BOT_MODEL=
